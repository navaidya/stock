---
import { withBase } from '../lib/url.ts';
import { freshness } from '../lib/data.ts';

interface Props {
  title: string;
  subtitle?: string;
  generatedAt: string;
}

const { title, subtitle, generatedAt } = Astro.props;
const fresh = freshness(generatedAt);

const nav = [
  { href: '/', label: 'My stocks' },
  { href: '/ai', label: 'AI' },
  { href: '/dividends', label: 'Dividends' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Stock Dashboard</title>
    <meta name="description" content="Personal stock analysis dashboard" />
    <link rel="icon" href={withBase('/favicon.svg')} />
  </head>
  <body>
    <header>
      <div class="bar">
        <strong>Stock Dashboard</strong>
        <span class={`fresh ${fresh.stale ? 'stale' : ''}`}>{fresh.label}</span>
      </div>
      <nav>
        {
          nav.map((item) => {
            const href = withBase(item.href);
            const active = current === href.replace(/\/$/, '');
            return (
              <a href={href} aria-current={active ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </header>

    <main>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <slot />
    </main>

    <footer>
      <p>
        Market data from Finnhub, refreshed on a schedule. Figures may be delayed
        and are not guaranteed accurate. This dashboard reports data and computed
        metrics only — it is not investment advice and makes no recommendations.
      </p>
    </footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #16181d;
        --muted: #5c6370;
        --line: #e3e6ea;
        --card: #f7f8fa;
        --up: #0a7d38;
        --down: #c0342b;
        --accent: #2f5fd0;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14161a;
          --fg: #e8eaed;
          --muted: #98a0ad;
          --line: #2a2e35;
          --card: #1c1f25;
          --up: #4ade80;
          --down: #f87171;
          --accent: #7aa2f7;
        }
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      header {
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 5;
      }
      .bar {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.75rem 1rem 0.5rem;
        flex-wrap: wrap;
      }
      .fresh { color: var(--muted); font-size: 0.8rem; }
      .fresh.stale { color: var(--down); }
      nav { display: flex; gap: 0.25rem; padding: 0 0.5rem; overflow-x: auto; }
      nav a {
        padding: 0.5rem 0.75rem;
        color: var(--muted);
        text-decoration: none;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
      }
      nav a[aria-current='page'] { color: var(--fg); border-bottom-color: var(--accent); }
      nav a:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      main { padding: 1rem; max-width: 100%; }
      h1 { font-size: 1.35rem; margin: 0.5rem 0 0.25rem; }
      .subtitle { color: var(--muted); margin: 0 0 1rem; max-width: 60ch; }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 2rem;
        padding: 1rem;
        color: var(--muted);
        font-size: 0.8rem;
      }
      footer p { max-width: 70ch; margin: 0; }

      .up { color: var(--up); }
      .down { color: var(--down); }
    </style>
  </body>
</html>
