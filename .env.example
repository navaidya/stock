# Copy to .env for local development. .env is gitignored and must stay that way;
# `npm run collect` and `npm run brief` load it automatically when it exists.
#
# In CI these come from the repository's Actions secrets — stored encrypted by
# GitHub, injected only into the step that asks for them, never committed.

# Free key: https://finnhub.io  (free tier is personal, non-commercial use)
FINNHUB_API_KEY=

# Optional. Without it `npm run brief` writes nothing and exits 0, and the
# dashboard renders with no brief — collection and deployment are unaffected.
#
# If you would rather not put this one in GitHub secrets, don't: run
# `npm run brief` locally and commit the data/brief.json it writes. The site is
# identical either way, and the key never leaves your machine.
# https://platform.claude.com  -> API keys
ANTHROPIC_API_KEY=
